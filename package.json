{
  "name": "MyRoutineRN",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "start": "react-native start",
    "start:reset": "npm run start -- --reset-cache",
    "clean:node": "watchman watch-del-all || true && rm -rf node_modules && npm install && npx pod-install || true",
    "android:reset": "cd android && ./gradlew clean && cd .. && npm run start:reset",
    "android:clean-install": "npm run clean:node && cd android && ./gradlew clean && cd .. && npm run android",
    "ios:reset": "cd ios && npx pod-install && xcodebuild -alltargets clean || true && cd .. && npm run start:reset",
    "ios:clean-install": "npm run clean:node && cd ios && npx pod-install && cd .. && npm run ios",
    "test": "jest",
    "android:fast": "react-native run-android --active-arch-only",
    "android:apk": "bash scripts/android.sh apk",
    "android:install": "bash scripts/android.sh install",
    "device:doctor": "bash scripts/android.sh doctor",
    "device:space": "bash scripts/android.sh space",
    "device:cache": "bash scripts/android.sh cache",
    "device:uninstall": "bash scripts/android.sh uninstall",
    "device:free": "bash scripts/android.sh free"
  },
  "dependencies": {
    "@howljs/calendar-kit": "^2.5.6",
    "@notifee/react-native": "^9.1.8",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.0",
    "@react-navigation/native": "^7.3.1",
    "@react-navigation/native-stack": "^7.17.3",
    "axios": "^1.17.0",
    "i18next": "^26.3.1",
    "react": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.0",
    "react-native-audio-recorder-player": "3.6.14",
    "react-native-gesture-handler": "^3.0.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "^4.4.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-worklets": "^0.9.2",
    "uuid": "^14.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
